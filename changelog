(function(){const b=st.build;const seen=b.seenFacs||["SH","MA","EM","WL","SN","RV","CP","WA"];
  Object.keys(FAC).forEach(k=>{if(!seen.includes(k)&&!b.facs.includes(k))b.facs.push(k);});b.seenFacs=Object.keys(FAC);saveBuild();})();
function saveBuild(){LS.set("op22.build",st.build)}

function reflow(line,def,off,prevDef,prevOff){
  const now=slots(def,off).map(s=>s.id);const old=slots(prevDef,prevOff).map(s=>s.id);
  const orphan=old.filter(id=>!now.includes(id)&&line[id]!=null).map(id=>line[id]);
  old.forEach(id=>{if(!now.includes(id))delete line[id]});
  for(const id of now){if(line[id]==null&&orphan.length)line[id]=orphan.shift();}
}

/* ---------- challenge ---------- */
function newChal(mode){
  const def=st.build.def, off=st.build.off;
  st.chal={mode,def,off,line:{},round:1,roll:null,pick:null,rr:{fac:2,fruit:2},skips:3,season:null,bag:mode==="draft"?shuffle(CHARS.map(c=>c.id)):null};
  roll();
}
function usedIds(line){return new Set(Object.values(line).filter(v=>v!=null))}
function legCount(line){return Object.values(line).filter(v=>v!=null&&CHARS[v].leg).length}
function chalPool(fac,fruit){
  const c=st.chal;const used=usedIds(c.line);const legOk=legCount(c.line)<3;
  return CHARS.filter(x=>!used.has(x.id)&&x.fac===fac&&x.fruit===fruit&&(legOk||!x.leg));
}
function roll(keep){
  const c=st.chal;c.pick=null;
  if(c.mode==="draft"){const used=usedIds(c.line);while(c.bag.length&&used.has(c.bag[0]))c.bag.shift();c.roll={char:c.bag.shift()};c.pick=c.roll.char;return;}
  for(let i=0;i<200;i++){
    const fac=keep==="fac"?c.roll.fac:rand(Object.keys(FAC));const fruit=keep==="fruit"?c.roll.fruit:rand(Object.keys(FRUIT));
    if(c.roll&&keep&&fac===c.roll.fac&&fruit===c.roll.fruit)continue;
    if(chalPool(fac,fruit).length){c.roll={fac,fruit};return;}
  }
  // fallback: any combination
  for(const fac of shuffle(Object.keys(FAC)))for(const fruit of shuffle(Object.keys(FRUIT)))if(chalPool(fac,fruit).length){c.roll={fac,fruit};return;}
}
function place(slotId){
  const c=st.chal;if(c.pick==null||c.line[slotId]!=null)return;
  c.line[slotId]=c.pick;c.pick=null;c.round++;
  if(c.round>22){c.roll=null;render();return;}
  roll();render();
}

/* ---------- season ---------- */
function playSeason(line,def,off,mode){
  const P=teamScore(line,def,off);let w=0;const games=OPP.map(o=>{
    const p=1/(1+Math.exp(-(P-o.p)/45));const win=Math.random()<p;
    const hi=17+Math.floor(Math.random()*25), lo=Math.max(0,hi-3-Math.floor(Math.random()*21));
    if(win)w++;return {o,win,us:win?hi:lo,them:win?lo:hi,p};
  });
  const res={P,w,l:17-w,games,line:{...line},def,off};
  if(mode){const s=st.stats[mode];s.runs++;if(s.best==null||P>s.best)s.best=P;if(s.rec==null||w>s.rec)s.rec=w;LS.set("op22.stats",st.stats);}
  return res;
}

/* ---------- render ---------- */
function ctx(){if(st.mode==="build"){const b=st.build;return {line:b.line,def:b.def,off:b.off};}const c=st.chal;return {line:c.line,def:c.def,off:c.off};}

function render(){
  document.querySelectorAll(".modes button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.mode===st.mode));
  const blurbs={build:"Build your dream lineup from any faction. Tags show each character's fit for the spot, out of 99. Simulate a 17-game season whenever you like.",
    c170:"Each round rolls a faction and a Devil Fruit type. Draft a matching character (up to 3 Legends) into any open spot. Fits stay hidden, so place them on instinct. Fill all 22, then play a 17-game season. Can you go 17–0?",
    draft:"Each round rolls one random character from the whole series. Put them in any open spot (3 skips per run), fill all 22, then play the season."};
  $("modeBlurb").textContent=blurbs[st.mode];
  $("buildPanel").hidden=st.mode!=="build";$("chalPanel").hidden=st.mode==="build";
  if(st.mode==="build")renderBuildPanel();else renderChalPanel();
  renderField();renderUnder();renderResults();
}

function segSet(id,val){document.querySelectorAll("#"+id+" button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.v===val))}
function renderBuildPanel(){
  const b=st.build;segSet("segDef",b.def);segSet("segOff",b.off);segSet("segLeg",b.leg);
  $("facChips").innerHTML=Object.entries(FAC).map(([k,v])=>`<button type="button" class="chip" data-fac="${k}" aria-pressed="${b.facs.includes(k)}">${v}</button>`).join("")+`<button type="button" class="chip" data-fac="ALL" aria-pressed="${b.facs.length===8}">All</button>`;
  const full=filled(b.line,b.def,b.off);const P=teamScore(b.line,b.def,b.off);
  const n=Object.values(b.line).filter(v=>v!=null).length;
  $("buildBoard").innerHTML=`<div><small>Team score</small><span class="big">${full?P:"–"}</span></div><div><small>Roster</small><span class="big">${n}/22</span></div><div class="grow"><small>Vs. Laugh Tale (910)</small><span class="big">${full?Math.round(100/(1+Math.exp(-(P-910)/45)))+"%":"–"}</span></div>`;
}
function renderChalPanel(){
