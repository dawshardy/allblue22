    <div class="acts"><button type="button" class="btn" id="rrFac" ${c.rr.fac?"":"disabled"}>Reroll faction (${c.rr.fac})</button><button type="button" class="btn" id="rrFruit" ${c.rr.fruit?"":"disabled"}>Reroll fruit (${c.rr.fruit})</button><button type="button" class="btn primary" id="choose">${pk?"Change pick":"Choose a character"}</button></div>
    <p class="hint">${pk?`<span class="drawn" style="display:inline-flex;vertical-align:middle;margin-right:6px">${avatar(pk,"md")}</span><b>${pk.name}</b> (${ovr(pk)} OVR) is ready. Tap an open spot to place them. Fits stay hidden until the season is played.`:"Pick from the matching characters, then tap an open spot."}</p>`;
  }else{
