let lastResult=null;
function renderResults(){
  const r=$("results");const res=st.mode==="build"?lastResult:st.chal.season;
  if(!res){r.hidden=true;r.innerHTML="";return;}
  r.hidden=false;
  const S=slots(res.def,res.off);
  const verdict=res.w===17?"Perfect season. King of the gridiron.":res.w>=14?"A Yonko-level team.":res.w>=10?"Playoff bound. The New World awaits.":res.w>=6?"Still sailing Paradise.":"Back to the East Blue.";
  r.innerHTML=`<div class="row" style="align-items:flex-end;gap:10px 22px"><div><h2>Season results</h2><p class="blurb" style="margin-top:6px">${verdict}</p></div><div class="rec">${res.w}–${res.l}</div><div class="board" style="margin-left:auto"><div><small>Team score</small><span class="big">${res.P}</span></div></div></div>
  <div class="games">${res.games.map((g,i)=>`<div class="game"><span class="wl ${g.win?"w":"l"}">${g.win?"W":"L"}</span><span class="op">${g.o.n}</span><span class="opp">${g.o.p}</span><span class="sc">${g.us}–${g.them}</span></div>`).join("")}</div>
  <details><summary>Season details</summary><p>Fit for each spot, out of 99. The number beside each opponent is their team score.</p><div class="grades">${S.map(s=>{const c=CHARS[res.line[s.id]];const f=fit(c,s.kind);return `<div><em>${s.label}</em><b>${c.name}</b><span style="color:${color(f)}">${f}</span></div>`}).join("")}</div></details>
  <div class="row"><button type="button" class="btn primary" id="saveImgRes">Save image</button><button type="button" class="btn" id="copyLinkRes">Copy link</button><button type="button" class="btn" id="shareRes">Copy results</button>${st.mode!=="build"?'<button type="button" class="btn primary" id="newRun3">New run</button>':'<button type="button" class="btn" id="sim2">Play again</button>'}</div>`;
}

/* ---------- picker sheet ---------- */
function openSheet(c){sheetCtx=c;$("q").value="";$("sheetExtra").hidden=c.type!=="photos";$("scrim").hidden=false;drawList();setTimeout(()=>$("q").focus(),30);}
function drawPhotos(q){
  const n=Object.keys(PHOTOS).length;
  $("sheetTitle").textContent="Player photos";$("sheetSub").textContent=`${n} of ${CHARS.length} players have a photo. Players without one show their faction badge.`;
  let items=CHARS.slice().sort((a,b)=>a.name.localeCompare(b.name));if(q)items=items.filter(x=>x.name.toLowerCase().includes(q));
  if(!items.length){$("list").innerHTML=`<div class="empty-list">No characters match that search.</div>`;return;}
  $("list").innerHTML=items.map(x=>`<div class="prow">${avatar(x,"md")}<span class="who"><b>${x.name}</b><span>${FAC[x.fac]} · ${FRUIT[x.fruit]}</span></span><span class="acts"><button type="button" class="btn ph-up" data-name="${x.name}">${PHOTOS[x.name]?"Replace":"Upload"}</button>${PHOTOS[x.name]?`<button type="button" class="btn danger ph-rm" data-name="${x.name}">Remove</button>`:""}</span></div>`).join("");
}
function closeSheet(){$("scrim").hidden=true;sheetCtx=null;}
function drawList(){
  const q=$("q").value.trim().toLowerCase();const c=sheetCtx;let items,kind=null,onField=new Map();
  if(c.type==="photos")return drawPhotos(q);
  if(c.type==="build"){
    const S=slots(st.build.def,st.build.off);const s=S.find(x=>x.id===c.slot);kind=s.kind;
    Object.entries(st.build.line).forEach(([k,v])=>{if(v!=null)onField.set(v,S.find(x=>x.id===k)?.label||k)});
    $("sheetTitle").textContent="Pick a "+s.label;$("sheetSub").textContent="Sorted by fit. Picking someone already on the field swaps the two.";
    items=buildPool();
  }else{
    const ch=st.chal;$("sheetTitle").textContent="Choose a character";
    $("sheetSub").textContent=`${FAC[ch.roll.fac]} · ${FRUIT[ch.roll.fruit]}${legCount(ch.line)>=3?" · Legend limit reached":""}`;
    items=chalPool(ch.roll.fac,ch.roll.fruit);
  }
  if(q)items=items.filter(x=>x.name.toLowerCase().includes(q));
  const S2=slots(ctx().def,ctx().off);
  const openKinds=c.type==="chal"?S2.filter(s=>st.chal.line[s.id]==null):[];
  const scoreOf=x=>kind?fit(x,kind):Math.max(...openKinds.map(s=>fit(x,s.kind)));
  const blind=c.type==="chal";   // challenges: no scores, no stats, alphabetical
  items=blind?items.map(x=>({x,f:ovr(x)})).sort((a,b)=>b.f-a.f||a.x.name.localeCompare(b.x.name)):items.map(x=>({x,f:scoreOf(x)})).sort((a,b)=>b.f-a.f);
  if(!items.length){
    const hidden=c.type==="build"&&q?CHARS.find(x=>x.name.toLowerCase().includes(q)&&!st.build.facs.includes(x.fac)):null;
    $("list").innerHTML=`<div class="empty-list">${hidden?`${hidden.name} is in ${FAC[hidden.fac]}, which is switched off. Turn it on under Factions.`:`No characters match. Try another search${c.type==="build"?" or turn on more factions":""}.`}</div>`;return;}
  $("list").innerHTML=items.map(({x,f})=>`<button type="button" class="pick" data-id="${x.id}"><span class="score" style="background:${color(f)}">${f}${blind?'<small class="ovr">OVR</small>':""}</span>${avatar(x,"md")}<span class="who"><b>${x.name}${x.leg?' <span style="color:var(--red)">★</span>':""}</b><span>${FAC[x.fac]} · ${FRUIT[x.fruit]}</span></span><span class="meta">${onField.has(x.id)?`<span class="onf">On field · ${onField.get(x.id)}</span><br>`:""}${blind?"":`<span class="stat">SPD ${x.spd} STR ${x.str} IQ ${x.iq}</span>`}</span></button>`).join("")
    + (c.type==="chal"?"":"");
}
