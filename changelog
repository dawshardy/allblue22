function initials(n){const w=n.replace(/[^A-Za-z' ]/g," ").split(/\s+/).filter(x=>x&&!/^(D|of)$/.test(x));return ((w[0]||"?")[0]+(w.length>1?w[w.length-1][0]:(w[0]||"")[1]||"")).toUpperCase();}
function avatar(c,size=""){
  const img=PHOTOS[c.name];
  return `<span class="av ${size} f-${c.fac} f${c.fruit}${c.leg?" leg":""}" aria-hidden="true">${img?`<img src="${img}" alt="">`:initials(c.name)}</span>`;
}
function savePhotos(){try{localStorage.setItem("op22.photos",JSON.stringify(PHOTOS));return true}catch(e){return false}}
function shrink(file){return new Promise((res,rej)=>{const r=new FileReader();r.onerror=rej;r.onload=()=>{const im=new Image();im.onerror=rej;im.onload=()=>{
  const s=Math.min(im.width,im.height);const sx=(im.width-s)/2;const sy=im.height>im.width?(im.height-s)*.12:0;
  const cv=document.createElement("canvas");cv.width=cv.height=128;const g=cv.getContext("2d");g.drawImage(im,sx,sy,s,s,0,0,128,128);res(cv.toDataURL("image/jpeg",.82));};im.src=r.result;};r.readAsDataURL(file);});}
const norm=s=>s.toLowerCase().replace(/\.[a-z0-9]+$/,"").replace(/[^a-z]/g,"");
function matchFile(fname){const f=norm(fname);if(f.length<3)return null;
  let hit=CHARS.find(c=>norm(c.name)===f);if(hit)return hit;
  const parts=c=>c.name.toLowerCase().split(/[^a-z]+/).filter(p=>p.length>2);
  hit=CHARS.filter(c=>norm(c.name).includes(f)||f.includes(norm(c.name))||parts(c).some(p=>p===f));
  return hit.length===1?hit[0]:null;}
let photoTarget=null;

function rand(a){return a[Math.floor(Math.random()*a.length)]}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}

/* ---------- team math ---------- */
function teamScore(line,def,off){
  const S=slots(def,off);let num=0,den=0;const fits=[];
  for(const s of S){const c=line[s.id];const f=c==null?0:fit(CHARS[c],s.kind);fits.push(f);num+=f*s.imp;den+=s.imp;}
  const mean=num/den;const weak=fits.slice().sort((a,b)=>a-b).slice(0,4);const wm=weak.reduce((a,b)=>a+b,0)/4;
  const r=mean-.35*(mean-wm);
  return Math.round(400+(r-55)*16);
}
function filled(line,def,off){return slots(def,off).every(s=>line[s.id]!=null)}

/* ---------- builder ---------- */
function buildPool(){const b=st.build;return CHARS.filter(c=>b.facs.includes(c.fac)&&(b.leg==="on"||!c.leg));}
function defaultLine(){
  const n=s=>CHARS.find(c=>c.name===s).id;
  return {QB:n("Nico Robin"),RB:n("Monkey D. Luffy"),X:n("Sanji"),WR1:n("Nami"),WR2:n("Brook"),TE:n("Franky"),
    LT:n("Jinbe"),LG:n("Urouge"),C:n("Trafalgar Law"),RG:n("Jozu"),RT:n("Bartholomew Kuma"),
    E1:n("Rob Lucci"),D1:n("Kaido"),D2:n("Big Mom"),E2:n("Charlotte Katakuri"),
    L1:n("Marco"),L2:n("Monkey D. Garp"),L3:n("Sabo"),CB1:n("Kizaru"),CB2:n("Carrot"),S1:n("Silvers Rayleigh"),S2:n("Benn Beckman")};
}
if(!st.build.line) st.build.line=defaultLine();
