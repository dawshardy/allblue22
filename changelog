$("field").addEventListener("drop",e=>{e.preventDefault();const t=e.target.closest(".tag");if(!t||!dragFrom)return;const to=t.dataset.slot;const l=st.build.line;
  [l[dragFrom],l[to]]=[l[to]??null,l[dragFrom]??null];dragFrom=null;lastResult=null;saveBuild();render();});
$("field").addEventListener("dragend",()=>{dragFrom=null;document.querySelectorAll(".dragover").forEach(x=>x.classList.remove("dragover"))});

async function copyText(t,msg){try{await navigator.clipboard.writeText(t);toast(msg)}catch(e){toast("Copy isn't available here")}}
function lineupText(line,def,off){return slots(def,off).map(s=>`${s.label.padEnd(4)} ${line[s.id]!=null?CHARS[line[s.id]].name:"—"}`).join("\n")}

document.addEventListener("click",e=>{
  const id=e.target.id;
  if(id==="sim"||id==="sim2"){const b=st.build;lastResult=playSeason(b.line,b.def,b.off,null);render();$("results").scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});}
  else if(id==="rand"){const b=st.build;const pool=shuffle(buildPool());const S=slots(b.def,b.off);if(pool.length<22){toast("Turn on more factions to fill 22 spots");return;}
    b.line={};S.forEach((s,i)=>b.line[s.id]=pool[i].id);lastResult=null;saveBuild();render();}
  else if(id==="reset"){st.build.line=defaultLine();reflow(st.build.line,st.build.def,st.build.off,"43","SL");lastResult=null;saveBuild();render();toast("Lineup reset")}
  else if(id==="clear"){st.build.line={};lastResult=null;saveBuild();render();}
  else if(id==="copy"){const b=st.build;copyText(`One Piece All-22 · team score ${filled(b.line,b.def,b.off)?teamScore(b.line,b.def,b.off):"–"}\n`+lineupText(b.line,b.def,b.off),"Lineup copied");}
  else if(id==="rrFac"&&st.chal.rr.fac){st.chal.rr.fac--;roll("fruit");render();}
  else if(id==="rrFruit"&&st.chal.rr.fruit){st.chal.rr.fruit--;roll("fac");render();}
  else if(id==="choose"){openSheet({type:"chal"});}
  else if(id==="photos"){openSheet({type:"photos"});}
  else if(id==="skip"&&st.chal.skips){st.chal.skips--;roll();render();}
  else if(id==="newRun"||id==="newRun2"||id==="newRun3"){newChal(st.mode);render();window.scrollTo({top:0});}
  else if(id==="seeRes"){const c=st.chal;c.season=playSeason(c.line,c.def,c.off,c.mode);render();$("results").scrollIntoView({behavior:"smooth"});}
  else if(id==="shareRes"){const res=st.mode==="build"?lastResult:st.chal.season;
    copyText(`One Piece All-22 · ${st.mode==="c170"?"17–0 Challenge":st.mode==="draft"?"Grand Line Draft":"Builder"}\nWent ${res.w}–${res.l} · team score ${res.P}\n`+lineupText(res.line,res.def,res.off),"Results copied");}
});

/* ---------- share links: #l-<def><off><2 base36 chars per slot>. Character ids are their row order in RAW, so only ever append new characters. ---------- */
function encodeLine(line,def,off){return "l-"+def+off+slots(def,off).map(s=>line[s.id]==null?"zz":line[s.id].toString(36).padStart(2,"0")).join("");}
function decodeLine(h){const m=/^l-(34|43)(FB|SL)([0-9a-z]{44})$/.exec(h||"");if(!m)return null;const def=m[1],off=m[2],line={},seen=new Set();
  slots(def,off).forEach((s,i)=>{const t=m[3].substr(i*2,2);if(t==="zz")return;const id=parseInt(t,36);if(CHARS[id]&&!seen.has(id)){line[s.id]=id;seen.add(id);}});return {def,off,line};}
function shareURL(line,def,off){return location.origin+location.pathname+"#"+encodeLine(line,def,off);}

let prevBuild=null;
(function loadShared(){let h="";try{h=decodeURIComponent((location.hash||"").slice(1));}catch(e){}
  const d=decodeLine(h);if(!d)return;
  prevBuild=JSON.parse(JSON.stringify(st.build));
  st.build.def=d.def;st.build.off=d.off;st.build.line=d.line;st.mode="build";st.sharedView=true;
  try{history.replaceState(null,"",location.pathname+location.search);}catch(e){}
})();
function renderShared(){
  const sb=$("sharedBar");if(!(st.sharedView&&st.mode==="build")){sb.hidden=true;return;}
  const b=st.build;const full=filled(b.line,b.def,b.off);
  sb.hidden=false;
  sb.innerHTML=`<p><b>A friend's lineup</b> · ${full?"team score "+teamScore(b.line,b.def,b.off):"not finished yet"}. Simulate a season to see how it holds up.</p>
  <button type="button" class="btn primary" id="keepShared">Keep it</button>${prevBuild&&prevBuild.line&&Object.keys(prevBuild.line).length?'<button type="button" class="btn" id="restoreMine">Back to my lineup</button>':""}`;
}

/* ---------- lineup image ---------- */
const IMG={sea:"#0d1b2a",sea3:"#1d3550",turf:"#1f6b3a",turf2:"#257a43",paper:"#efe0bd",paper2:"#e3cf9f",ink:"#2b1d0e",ink2:"#6b5132",gold:"#f0b429",red:"#d9483b",muted:"#93a7bb",
  fac:{SH:"#b8382b",MA:"#2f5f93",EM:"#5d3b8e",WL:"#1d6a64",SN:"#b8641f",RV:"#3c6f34",CP:"#545c68",WA:"#9a2c58",FA:"#7a7466"}};
const fitHex=f=>f>=80?"#4cc27a":f>=65?"#e9c046":"#e2694f";
function rr(g,x,y,w,h,r){g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}
function wrap2(g,text,maxW){const words=text.split(" ");const lines=[];let cur="";
  for(const w of words){const t=cur?cur+" "+w:w;if(g.measureText(t).width<=maxW||!cur)cur=t;else{lines.push(cur);cur=w;}}lines.push(cur);
  if(lines.length>2){lines.length=2;lines[1]+="…";}
  return lines.map(l=>{if(g.measureText(l).width<=maxW)return l;while(l.length>1&&g.measureText(l+"…").width>maxW)l=l.slice(0,-1);return l+"…";});}
function loadImg(src){return new Promise(r=>{const i=new Image();i.onload=()=>r(i);i.onerror=()=>r(null);i.src=src;});}
function drawBadge(g,c,cx,cy,r,photo){
  g.save();g.beginPath();g.arc(cx,cy,r,0,Math.PI*2);g.clip();
  if(photo){g.drawImage(photo,cx-r,cy-r,r*2,r*2);}
  else{
    g.fillStyle=IMG.fac[c.fac];g.fillRect(cx-r,cy-r,r*2,r*2);
    g.strokeStyle="rgba(255,255,255,.16)";g.lineWidth=3;
    if(c.fruit==="P"){for(let k=6;k<r*2.2;k+=9){g.beginPath();g.arc(cx-r*.45,cy-r*.5,k,0,Math.PI*2);g.stroke();}}
    else if(c.fruit==="Z"){g.strokeStyle="rgba(0,0,0,.2)";g.lineWidth=4;for(let k=-r*2;k<r*2;k+=11){g.beginPath();g.moveTo(cx+k,cy-r);g.lineTo(cx+k+r*2,cy+r);g.stroke();}}
    else if(c.fruit==="L"){for(let k=8;k<r*2.6;k+=10){g.beginPath();g.ellipse(cx,cy+r*1.3,k*1.4,k*.6,0,0,Math.PI*2);g.stroke();}}
    else{const gr=g.createLinearGradient(cx-r,cy-r,cx+r,cy+r);gr.addColorStop(0,"rgba(255,255,255,.18)");gr.addColorStop(1,"rgba(0,0,0,.2)");g.fillStyle=gr;g.fillRect(cx-r,cy-r,r*2,r*2);}
    g.fillStyle="#fff8e8";g.font=`400 ${Math.round(r*.95)}px "Pirata One", Georgia, serif`;g.textAlign="center";g.textBaseline="middle";
    g.shadowColor="rgba(0,0,0,.45)";g.shadowOffsetY=2;g.fillText(initials(c.name),cx,cy+2);
  }
  g.restore();
  g.beginPath();g.arc(cx,cy,r,0,Math.PI*2);g.lineWidth=c.leg?4:3;g.strokeStyle=c.leg?IMG.gold:"rgba(255,248,232,.5)";g.stroke();
}
async function lineupImage(line,def,off,o){
  try{await Promise.all(['400 60px "Pirata One"','700 22px "Barlow Condensed"','800 22px "Barlow Condensed"'].map(f=>document.fonts.load(f)));}catch(e){}
  const S=slots(def,off);const photos={};
  await Promise.all(S.map(async s=>{const id=line[s.id];if(id!=null&&PHOTOS[CHARS[id].name])photos[id]=await loadImg(PHOTOS[CHARS[id].name]);}));
  const W=1080,H=1350,cv=document.createElement("canvas");cv.width=W;cv.height=H;const g=cv.getContext("2d");
  const ls=v=>{try{g.letterSpacing=v}catch(e){}};
  g.fillStyle=IMG.sea;g.fillRect(0,0,W,H);
  // header
  g.textBaseline="alphabetic";g.textAlign="left";g.font='400 84px "Pirata One", Georgia, serif';
  g.fillStyle=IMG.paper;g.fillText("One Piece ",48,104);const tw=g.measureText("One Piece ").width;g.fillStyle=IMG.gold;g.fillText("All-22",48+tw,104);
  ls("3px");g.font='700 26px "Barlow Condensed", "Arial Narrow", sans-serif';g.fillStyle=IMG.muted;g.fillText(o.sub.toUpperCase(),50,148);
  g.textAlign="right";g.font='800 22px "Barlow Condensed", "Arial Narrow", sans-serif';g.fillText(o.bigLabel.toUpperCase(),1032,64);ls("0px");
  g.font='800 76px "Barlow Condensed", "Arial Narrow", sans-serif';g.fillStyle=IMG.gold;g.fillText(o.big,1032,138);
  // field
  const x0=48,y0=176,fw=984,fh=1090,rowH=fh/6;
  g.save();rr(g,x0,y0,fw,fh,14);g.clip();
  for(let i=0;i<6;i++){g.fillStyle=i%2?IMG.turf2:IMG.turf;g.fillRect(x0,y0+i*rowH,fw,rowH);}
  g.strokeStyle="rgba(255,255,255,.4)";g.lineWidth=2;for(let i=1;i<12;i++){if(i===6)continue;const y=y0+i*rowH/2;g.beginPath();g.moveTo(x0,y);g.lineTo(x0+fw,y);g.stroke();}
  const vg=g.createRadialGradient(x0+fw/2,y0+fh/2,fh*.3,x0+fw/2,y0+fh/2,fh*.8);vg.addColorStop(0,"rgba(0,0,0,0)");vg.addColorStop(1,"rgba(0,0,0,.3)");g.fillStyle=vg;g.fillRect(x0,y0,fw,fh);
  const losY=y0+rowH*3-6;g.fillStyle=IMG.gold;g.fillRect(x0,losY,fw,4);
  g.restore();
  rr(g,x0,y0,fw,fh,14);g.lineWidth=6;g.strokeStyle="#e9f0e6";g.stroke();
  g.font='400 30px "Pirata One", Georgia, serif';g.fillStyle="rgba(255,255,255,.75)";g.textAlign="left";g.fillText("Defense",x0+14,y0+34);g.fillText("Offense",x0+14,losY+36);
  // tags
  const tw2=124,th=158;
  for(const s of S){
    const cx=x0+s.x/100*fw;const top=y0+s.row*rowH+(s.row>=3?16:8);const x=cx-tw2/2;const id=line[s.id];
    if(id==null){rr(g,x,top,tw2,th,8);g.setLineDash([7,6]);g.lineWidth=2;g.strokeStyle="rgba(239,224,189,.6)";g.stroke();g.setLineDash([]);
      g.fillStyle=IMG.paper;g.font='800 20px "Barlow Condensed", sans-serif';g.textAlign="center";g.fillText(s.label,cx,top+30);continue;}
    const c=CHARS[id];const f=fit(c,s.kind);
    g.save();g.shadowColor="rgba(0,0,0,.35)";g.shadowBlur=12;g.shadowOffsetY=5;rr(g,x,top,tw2,th,8);g.fillStyle=IMG.paper;g.fill();g.restore();
    g.fillStyle=IMG.paper2;g.fillRect(x+4,top+th-1,tw2-8,4);
    ls("2px");g.font='800 19px "Barlow Condensed", sans-serif';g.textAlign="left";g.textBaseline="middle";g.fillStyle=IMG.ink2;g.fillText(s.label,x+9,top+19);ls("0px");
    g.font='800 19px "Barlow Condensed", sans-serif';const fs=String(f);const pw=g.measureText(fs).width+12;
    rr(g,x+tw2-pw-7,top+8,pw,23,4);g.fillStyle=fitHex(f);g.fill();g.fillStyle="#14140f";g.textAlign="center";g.fillText(fs,x+tw2-7-pw/2,top+20);
    drawBadge(g,c,cx,top+68,33,photos[id]);
    g.fillStyle=IMG.ink;g.font='700 21px "Barlow Condensed", "Arial Narrow", sans-serif';g.textAlign="center";g.textBaseline="alphabetic";
    let lines=wrap2(g,c.name,tw2-10);
    if(lines.some(l=>l.endsWith("…"))){g.font='700 17px "Barlow Condensed", "Arial Narrow", sans-serif';lines=wrap2(g,c.name,tw2-8);}lines.forEach((l,i)=>g.fillText(l,cx,top+(lines.length===1?132:122)+i*22));
  }
  // footer
  g.textBaseline="alphabetic";g.textAlign="left";g.font='700 28px "Barlow Condensed", sans-serif';g.fillStyle=IMG.paper;g.fillText("allblue22.com",48,1318);
  g.textAlign="right";g.fillStyle=IMG.muted;g.font='600 24px "Barlow Condensed", sans-serif';g.fillText("Build your crew. Go 17–0.",1032,1318);
  return new Promise(r=>cv.toBlob(r,"image/png"));
}
let imgState=null;
async function openImage(line,def,off,o){
  toast("Drawing your lineup…");
  const blob=await lineupImage(line,def,off,o);if(!blob){toast("Couldn't draw the image");return;}
  if(imgState?.url)URL.revokeObjectURL(imgState.url);
  const url=URL.createObjectURL(blob);imgState={blob,url,link:shareURL(line,def,off)};
  $("imgOut").src=url;$("imgDl").href=url;
  const file=new File([blob],"allblue22-lineup.png",{type:"image/png"});imgState.file=file;
  let canShare=false;try{canShare=!!(navigator.canShare&&navigator.canShare({files:[file]}))&&matchMedia("(pointer:coarse)").matches;}catch(e){}
  $("imgShare").hidden=!canShare;$("imgCopy").hidden=!(window.ClipboardItem&&navigator.clipboard?.write);
  $("toast").hidden=true;$("imgScrim").hidden=false;$("imgClose").focus();
}
function imgOptsBuild(){const b=st.build;return {sub:`${b.def==="43"?"4-3":"3-4"} defense · ${b.off==="SL"?"slot":"fullback"} offense`,big:String(teamScore(b.line,b.def,b.off)),bigLabel:"Team score"};}
function imgOptsResult(res){const m={build:"Season",c170:"17–0 Challenge",draft:"Grand Line Draft"}[st.mode];return {sub:`${m} · team score ${res.P}`,big:`${res.w}–${res.l}`,bigLabel:"Record"};}
$("imgClose").addEventListener("click",()=>{$("imgScrim").hidden=true;});
$("imgScrim").addEventListener("click",e=>{if(e.target===$("imgScrim"))$("imgScrim").hidden=true;});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!$("imgScrim").hidden)$("imgScrim").hidden=true;});
$("imgShare").addEventListener("click",async()=>{try{await navigator.share({files:[imgState.file],text:"My One Piece All-22 lineup",url:imgState.link});}catch(e){}});
$("imgCopy").addEventListener("click",async()=>{try{await navigator.clipboard.write([new ClipboardItem({"image/png":imgState.blob})]);toast("Image copied");}catch(e){toast("Copy isn't available here. Download it instead.");}});
$("imgLink").addEventListener("click",()=>copyText(imgState.link,"Link copied"));

document.addEventListener("click",e=>{
  const id=e.target.id;
  if(id==="saveImg"){const b=st.build;openImage(b.line,b.def,b.off,imgOptsBuild());}
  else if(id==="copyLink"){const b=st.build;copyText(shareURL(b.line,b.def,b.off),"Link copied. Anyone who opens it sees this lineup.");}
  else if(id==="saveImgRes"){const res=st.mode==="build"?lastResult:st.chal.season;openImage(res.line,res.def,res.off,imgOptsResult(res));}
  else if(id==="copyLinkRes"){const res=st.mode==="build"?lastResult:st.chal.season;copyText(shareURL(res.line,res.def,res.off),"Link copied");}
  else if(id==="keepShared"){st.sharedView=false;saveBuild();render();toast("Saved as your lineup");}
  else if(id==="restoreMine"){st.build=prevBuild;prevBuild=null;st.sharedView=false;lastResult=null;render();toast("Your lineup is back");}
});
const _render=render;render=function(){_render();renderShared();};

render();
</script>
