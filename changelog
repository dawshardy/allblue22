// Overall power, independent of position: mostly the average rating, nudged up by the two best traits. Size is ignored.
function ovr(c){const v=[c.spd,c.str,c.tec,c.iq,c.dur];if(v.every(x=>x===1))return 1;const avg=v.reduce((a,b)=>a+b,0)/5;const top=v.slice().sort((a,b)=>b-a);
  return Math.min(99,Math.round((.6*avg+.4*(top[0]+top[1])/2)*10));}
function fit(c,kind){if(c.spd+c.str+c.tec+c.iq+c.dur+c.size===6)return 1;const k=KIND[kind];let v=0;for(const s in k.w)v+=k.w[s]*c[s];v*=10;const d=Math.abs(c.size-k.size);v-=Math.max(0,d-1)*3.5;return Math.max(15,Math.min(99,Math.round(v)));}

const ROWH = 98, TOP = 22;
function slots(def,off){
  const S=[];const a=(id,label,kind,row,x,imp=1)=>S.push({id,label,kind,row,x,imp});
  a("S1","FS","S",0,33);a("S2","SS","S",0,67);
  a("CB1","CB","CB",1,9,1.5);a("CB2","CB","CB",1,91,1.5);
  if(def==="43"){a("E1","DE","ED",2,18,1.5);a("D1","DT","DT",2,39);a("D2","DT","DT",2,61);a("E2","DE","ED",2,82,1.5);
    a("L1","OLB","LB",1,30);a("L2","MLB","LB",1,50);a("L3","OLB","LB",1,70);}
  else{a("E1","OLB","ED",2,10,1.5);a("D1","DE","DT",2,30);a("D2","NT","DT",2,50);a("D3","DE","DT",2,70);a("E2","OLB","ED",2,90,1.5);
    a("L1","ILB","LB",1,37);a("L2","ILB","LB",1,63);}
  [["LT",18],["LG",32],["C",46],["RG",60],["RT",74]].forEach(([id,x])=>a(id,id,"OL",3,x));
  a("TE","TE","TE",3,89);a("WR1","WR","WR",4,9);a("WR2","WR","WR",4,91);a("QB","QB","QB",4,46,2);
  if(off==="SL"){a("X","SLOT","SL",4,27);a("RB","RB","RB",5,46);}else{a("X","FB","FB",5,34);a("RB","RB","RB",5,58);}
  return S;
}

