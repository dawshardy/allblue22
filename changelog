  $("chalBoard").innerHTML=`<div><small>Best score</small><span class="big">${s.best??"–"}</span></div><div><small>Best record</small><span class="big">${s.rec==null?"–":s.rec+"–"+(17-s.rec)}</span></div><div><small>Runs</small><span class="big">${s.runs}</span></div><div class="grow"><small>Legends used</small><span class="big">${c.mode==="c170"?legCount(c.line)+"/3":"–"}</span></div>`;
