    rc.innerHTML=`<div><div class="round">Round ${c.round} of 22</div><div class="draw"><div class="drawn">${avatar(pk,"lg")}<div><span>${FAC[pk.fac]} · ${FRUIT[pk.fruit]}${pk.leg?" · Legend":""}</span><b>${pk.name}</b></div><span class="ovrchip" style="background:${color(ovr(pk))}">${ovr(pk)}<small>OVR</small></span></div></div></div>
    <div class="acts"><button type="button" class="btn" id="skip" ${c.skips?"":"disabled"}>Skip (${c.skips} left)</button><button type="button" class="btn" id="newRun">New run</button></div>
    <p class="hint">Tap an open spot to place them. Trust your gut: fits stay hidden until the season is played.</p>`;
  }
}

function renderField(){
  const {line,def,off}=ctx();const S=slots(def,off);const f=$("field");
  const placing=st.mode!=="build"&&st.chal.pick!=null&&st.chal.round<=22;
  const pick=placing?CHARS[st.chal.pick]:null;
  const hideFit=st.mode!=="build"&&!st.chal.season;   // challenges: no fit hints until the season is played
  f.style.height=(TOP*2+ROWH*6)+"px";
  let h=`<div class="side-tag" style="top:4px">Defense</div><div class="los" style="top:${TOP+ROWH*3-10}px"></div><div class="side-tag" style="top:${TOP+ROWH*3-4}px">Offense</div>`;
  for(const s of S){
    const id=line[s.id];const top=TOP+s.row*ROWH+(s.row>=3?4:-6);
    if(id==null){
      const prev=pick?`<span class="preview">?</span><span class="nm">Place here</span>`:`<span class="hole"></span><span class="nm">Empty</span>`;
      const dis=st.mode!=="build"&&!placing;
      h+=`<button type="button" class="tag empty${placing?" target":""}" style="left:${s.x}%;top:${top}px" data-slot="${s.id}" ${dis?"disabled":""} aria-label="${s.label} open spot"><span class="pos"><span>${s.label}</span></span>${prev}</button>`;
    }else{
      const c=CHARS[id];const ft=fit(c,s.kind);
      h+=`<button type="button" class="tag" style="left:${s.x}%;top:${top}px" data-slot="${s.id}" draggable="${st.mode==="build"}" ${st.mode!=="build"?"disabled":""} aria-label="${s.label}: ${c.name}${hideFit?"":", fit "+ft}"><span class="pos"><span>${s.label}${c.leg?' <span class="leg">★</span>':""}</span><span class="fit" style="background:${hideFit?"var(--paper-2)":color(ft)}">${hideFit?"?":ft}</span></span>${avatar(c)}<span class="nm">${c.name}</span></button>`;
    }
  }
  f.innerHTML=h;
}

